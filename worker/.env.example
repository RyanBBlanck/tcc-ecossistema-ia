# Porta HTTP do worker
PORT=3030

# Chave enviada pelo n8n no header x-api-key (use qualquer string secreta)
WORKER_API_KEY=troque-por-um-valor-secreto

# Caminho do executável do Claude Code (deixe "claude" se estiver no PATH)
CLAUDE_BIN=claude

# Tempo máximo de cada execução do Claude Code, em milissegundos (10 min)
CLAUDE_TIMEOUT_MS=600000

# Projeto padrão no Lovable
LOVABLE_PROJECT_NAME=NOME_DO_SEU_PROJETO_NO_LOVABLE
LOVABLE_PROJECT_ID=
